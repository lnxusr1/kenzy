# Copy this file to .env and fill in values.
# .env is never committed — it holds secrets for local development.

# OpenAI API key. Get this from your OpenAI account dashboard.
OPENAI_API_KEY="sb-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Home Assistant API key. Get this from your Home Assistant user profile page.
HA_API_KEY=""

# Hugging Face token for private models. Not needed for public models.
HF_TOKEN=""

# MQTT broker login for the Home Assistant integration (integrations.mqtt).
# Only needed if you enable it AND your broker requires auth; leave blank otherwise.
KENZY_MQTT_USERNAME=""
KENZY_MQTT_PASSWORD=""