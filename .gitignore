# Environment / secrets
.env
.env.*
!.env.example
# Key material anywhere in the tree (dev certs live under /configs/, but a
# stray openssl output must never land in a public repo either)
*.key
*.pem
*.crt
# Backup archives (dashboard "Download backup" bundles configs + household data;
# with ?secrets=1 they can even carry .env) — root-anchored so packaged test
# fixtures under src/ or tests/ could still be tracked deliberately if ever needed
/*.tar.gz
# Stray runtime logs
*.log

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
*.egg
pip-wheel-metadata/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/
.pytype/

# Test / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Downloaded ML models (the `./` form was a no-op in gitignore syntax — anchor properly)
/models/

# Operator/runtime data — the WHOLE tree. In a dev checkout the repo root is the
# config home, so everything under /data/ is this household's live state, never
# fixture data: voice embeddings (data/speakers/), the HA curation layer, the
# schedule store (schedules.json), person records (people.yaml — voiceprint↔person
# links), and the memory fact ledger (data/memory/ — the most personal thing
# Kenzy holds). None of it belongs in a public repository. Tests use tmp dirs;
# the docs show example schemas inline.
/data/

# Operator/site-specific config — never commit (it holds your rooms, HA URL, location,
# auth, etc.). Generic templates live in examples/. (.env is ignored above.)
# Leading slash anchors these to the repo root so they only match the top-level
# operator tree — NOT the packaged defaults under src/kenzy/data/configs/, which
# ship as package data and must stay tracked.
/configs/hosts/
/configs/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/
CLAUDE.md
/models/wakeword
/models/speaker
/design/
/site/
/www/
screenshot_site.py

build_pypi.sh
publish.sh
